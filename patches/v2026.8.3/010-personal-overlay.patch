+
+def test_max_accepts_profile_local_ca_bundle_override(tmp_path):
+    from plugins.platforms.max.adapter import MaxAdapter
+
+    ca_bundle = tmp_path / "max-ca.pem"
+    ca_bundle.write_text("placeholder")
+    adapter = MaxAdapter(
+        PlatformConfig(
+            enabled=True,
+            token="max-token",
+            extra={"transport": "polling", "ca_bundle": str(ca_bundle)},
+        )
+    )
+
+    assert adapter.ca_bundle == ca_bundle
+
+
+def test_max_rejects_missing_ca_bundle(tmp_path):
+    from plugins.platforms.max.adapter import MaxAdapter
+
+    with pytest.raises(ValueError, match="CA bundle is missing or unreadable"):
+        MaxAdapter(
+            PlatformConfig(
+                enabled=True,
+                token="max-token",
+                extra={"ca_bundle": str(tmp_path / "missing.pem")},
+            )
+        )
+
+
+@pytest.mark.asyncio
+async def test_max_media_cache_receives_scoped_ca_bundle():
+    from plugins.platforms.max.adapter import MaxAdapter
+
+    adapter = MaxAdapter(PlatformConfig(enabled=True, token="max-token", extra={"transport": "polling"}))
+
+    with patch("plugins.platforms.max.adapter.cache_image_from_url", return_value="/tmp/image.jpg") as image_cache:
+        event = SimpleNamespace(
+            media_urls=["https://platform-api2.max.ru/media/image"],
+            media_types=["image/jpeg"],
+            message_type=MessageType.PHOTO,
+            raw_message={},
+        )
+        await adapter._cache_attachment_media(event)
+
+    assert image_cache.call_args.kwargs["verify"] == str(adapter.ca_bundle)
+
+
+@pytest.mark.asyncio
+async def test_send_text_uses_max_markdown_format_and_raw_authorization():
+    from plugins.platforms.max.adapter import MaxAdapter
+
+    adapter = MaxAdapter(PlatformConfig(enabled=True, token="max-token", extra={"transport": "polling"}))
+    client = RecordingClient()
+    adapter._client = client
+
+    result = await adapter.send("chat:777", "**hello**", metadata={"notify": False})
+
+    assert isinstance(result, SendResult)
+    assert result.success is True
+    assert client.posts[0]["url"].endswith("/messages")
+    assert client.posts[0]["params"] == {"chat_id": "777"}
+    assert client.posts[0]["headers"]["Authorization"] == "max-token"
+    assert "Bearer" not in client.posts[0]["headers"]["Authorization"]
+    assert client.posts[0]["json"] == {
+        "text": "**hello**",
+        "notify": False,
+        "format": "markdown",
+    }
+
+
+@pytest.mark.asyncio
+async def test_send_typing_uses_max_group_action_endpoint():
+    from plugins.platforms.max.adapter import MaxAdapter
+
+    adapter = MaxAdapter(PlatformConfig(enabled=True, token="max-token", extra={"transport": "polling"}))
+    client = RecordingClient()
+    adapter._client = client
+
