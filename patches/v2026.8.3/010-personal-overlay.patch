+def _sse_events(raw: str):
+    events = []
+    event_name = None
+    for line in raw.splitlines():
+        if line.startswith("event: "):
+            event_name = line[len("event: "):]
+        elif line.startswith("data: "):
+            data = line[len("data: "):]
+            events.append((event_name, data))
+            event_name = None
+    return events
