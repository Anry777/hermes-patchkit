+def _sse_data_payloads(raw: str):
+    payloads = []
+    for line in raw.splitlines():
+        if not line.startswith("data: "):
+            continue
+        data = line[len("data: "):]
+        if data == "[DONE]":
+            payloads.append("[DONE]")
+        else:
+            payloads.append(data)
+    return payloads
+
