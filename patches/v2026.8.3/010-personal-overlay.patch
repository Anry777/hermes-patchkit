+@dataclass(frozen=True)
+class ResolvedProxyTarget:
+    public_id: str
+    provider: str
+    model: str
+    api_mode: str
+    base_url: str
+    api_key: str
+    runtime: Dict[str, Any]
+    credential_pool: Any = None
+    credential_id: Optional[str] = None
