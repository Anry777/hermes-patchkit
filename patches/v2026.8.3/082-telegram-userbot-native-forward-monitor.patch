+class FakeNativeForwardClient:
+    """Small in-memory Telethon surface for native-forward monitor tests."""
+
+    def __init__(self, source_messages, destination_messages=()):
+        self.source_messages = list(source_messages)
+        self.destination_messages = list(destination_messages)
+        self.forward_calls = []
+
+    async def get_entity(self, entity_id):
+        return SimpleNamespace(id=abs(int(entity_id)))
+
+    async def iter_messages(self, entity, **_kwargs):
+        messages = (
+            self.source_messages
+            if int(getattr(entity, "id", entity)) == 1001
+            else self.destination_messages
+        )
+        for message in sorted(messages, key=lambda item: item.id, reverse=True):
+            yield message
+
+    async def forward_messages(self, destination, messages, *, from_peer):
+        records = list(messages)
+        self.forward_calls.append(
+            {"destination": destination, "messages": records, "from_peer": from_peer}
+        )
+        for message in records:
+            self.destination_messages.append(
+                SimpleNamespace(
+                    id=10000 + message.id,
+                    fwd_from=SimpleNamespace(
+                        channel_post=message.id,
+                        from_id=SimpleNamespace(channel_id=1001),
+                    ),
+                )
+            )
+
+
+def native_forward_message(message_id, *, grouped_id=None):
+    return SimpleNamespace(id=message_id, grouped_id=grouped_id, action=None)
+
 
