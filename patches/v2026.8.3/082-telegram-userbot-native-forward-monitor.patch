+def _native_forward_monitors(value: Any) -> tuple[_NativeForwardMonitor, ...]:
+    if value is None:
+        return ()
+    if not isinstance(value, list):
+        raise ValueError("native_forward_monitors must be a list")
+
+    monitors: list[_NativeForwardMonitor] = []
+    names: set[str] = set()
+    for item in value:
+        if not isinstance(item, dict):
+            raise ValueError("native_forward_monitors entries must be mappings")
+        name = _as_str(item.get("name")).strip()
+        if (
+            not name
+            or len(name) > 80
+            or any(char not in "abcdefghijklmnopqrstuvwxyz0123456789_-" for char in name)
+        ):
+            raise ValueError(
+                "native_forward_monitors.name must contain only lowercase letters, digits, _ or -"
+            )
+        if name in names:
+            raise ValueError(f"duplicate native forward monitor name: {name}")
+        source_value = item.get("source_id", item.get("source"))
+        source_id = _coerce_int(source_value)
+        destination_id = _coerce_int(item.get("destination_id"))
+        if source_id is not None:
+            if source_id <= 0:
+                raise ValueError("native_forward_monitors.source_id must be a positive integer")
+            source: int | str = source_id
+        elif isinstance(source_value, str) and source_value.strip():
+            source = source_value.strip().lstrip("@")
+        else:
+            raise ValueError(
+                "native_forward_monitors requires a positive source_id or non-empty source"
+            )
+        if destination_id is None or destination_id <= 0:
+            raise ValueError("native_forward_monitors.destination_id must be a positive integer")
+        if source_id == destination_id:
+            raise ValueError("native forward source and destination must differ")
+        monitors.append(
+            _NativeForwardMonitor(
+                name=name,
+                source=source,
+                destination_id=destination_id,
+                interval_seconds=_positive_int(item.get("interval_seconds"), 10800),
+            )
+        )
+        names.add(name)
+    return tuple(monitors)
+
