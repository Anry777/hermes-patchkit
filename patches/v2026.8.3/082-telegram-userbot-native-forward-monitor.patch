+    def _monitor_state_path(self, monitor: _NativeForwardMonitor) -> Path:
+        root = get_hermes_home() / "native_forwards"
+        if root.is_symlink():
+            raise RuntimeError("native forward state directory must not be a symlink")
+        root.mkdir(parents=True, exist_ok=True)
+        try:
+            os.chmod(root, 0o700)
+        except OSError:
+            pass
+        path = root / f"{monitor.name}.json"
+        if path.is_symlink():
+            raise RuntimeError("native forward state file must not be a symlink")
+        return path
+
+    def _load_monitor_state(self, monitor: _NativeForwardMonitor) -> Optional[int]:
+        path = self._monitor_state_path(monitor)
+        if not path.exists():
+            return None
+        try:
+            state = json.loads(path.read_text(encoding="utf-8"))
+        except (OSError, ValueError, TypeError) as exc:
+            raise RuntimeError(f"native forward state is unreadable: {monitor.name}") from exc
+        if not isinstance(state, dict):
+            raise RuntimeError(f"native forward state is invalid: {monitor.name}")
+        if _coerce_int(state.get("destination_id")) != monitor.destination_id:
+            raise RuntimeError(f"native forward state route mismatch: {monitor.name}")
+        if isinstance(monitor.source, int):
+            route_matches = _coerce_int(state.get("source_id")) == monitor.source
+        else:
+            route_matches = state.get("source") == monitor.source
+        if not route_matches:
+            raise RuntimeError(f"native forward state route mismatch: {monitor.name}")
+        cursor = _coerce_int(state.get("last_processed_message_id"))
+        if cursor is None or cursor < 0:
+            raise RuntimeError(f"native forward state cursor is invalid: {monitor.name}")
+        return cursor
+
+    def _store_monitor_state(
+        self,
+        monitor: _NativeForwardMonitor,
+        last_processed_message_id: int,
+        source_id: int,
+    ) -> None:
+        path = self._monitor_state_path(monitor)
+        descriptor, temporary = tempfile.mkstemp(
+            prefix=f".{monitor.name}.", suffix=".tmp", dir=path.parent
+        )
+        try:
+            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
+                json.dump(
+                    {
+                        **({"source_id": source_id} if isinstance(monitor.source, int) else {
+                            "source": monitor.source,
+                            "source_id": source_id,
+                        }),
+                        "destination_id": monitor.destination_id,
+                        "last_processed_message_id": last_processed_message_id,
+                    },
+                    handle,
+                    sort_keys=True,
+                )
+                handle.write("\n")
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.chmod(temporary, 0o600)
+            os.replace(temporary, path)
+        finally:
+            try:
+                os.unlink(temporary)
+            except FileNotFoundError:
+                pass
+
+    @staticmethod
+    def _forwarded_source_message_id(message: Any, source_id: int) -> Optional[int]:
+        header = getattr(message, "fwd_from", None)
+        if header is None:
+            return None
+        from_id = getattr(header, "from_id", None)
+        peer_id = (
+            getattr(from_id, "channel_id", None)
+            or getattr(from_id, "chat_id", None)
+            or getattr(from_id, "user_id", None)
+        )
+        if _coerce_int(peer_id) != source_id:
+            return None
+        return _coerce_int(
+            getattr(header, "channel_post", None)
+            or getattr(header, "saved_from_msg_id", None)
+        )
+
+    async def _destination_forward_ids(
+        self, client: Any, destination: Any, source_id: int
+    ) -> set[int]:
+        forwarded: set[int] = set()
+        async for message in client.iter_messages(destination, limit=1000):
+            source_message_id = self._forwarded_source_message_id(message, source_id)
+            if source_message_id is not None:
+                forwarded.add(source_message_id)
+        return forwarded
+
+    async def _latest_source_message_id(self, client: Any, source: Any) -> int:
+        async for message in client.iter_messages(source, limit=1):
+            message_id = _coerce_int(getattr(message, "id", None))
+            if message_id is not None:
+                return message_id
+        return 0
+
+    async def _new_source_publications(
+        self, client: Any, source: Any, cursor: int
+    ) -> tuple[list[list[Any]], int]:
+        records: list[Any] = []
+        highest_seen = cursor
+        async for message in client.iter_messages(source):
+            message_id = _coerce_int(getattr(message, "id", None))
+            if message_id is None:
+                continue
+            if message_id <= cursor:
+                break
+            highest_seen = max(highest_seen, message_id)
+            if getattr(message, "action", None) is None:
+                records.append(message)
+        records.sort(key=lambda item: int(item.id))
+        grouped: dict[tuple[str, int], list[Any]] = {}
+        for message in records:
+            grouped_id = _coerce_int(getattr(message, "grouped_id", None))
+            key = (
+                ("album", grouped_id)
+                if grouped_id is not None
+                else ("message", int(message.id))
+            )
+            grouped.setdefault(key, []).append(message)
+        publications = list(grouped.values())
+        publications.sort(key=lambda items: min(int(item.id) for item in items))
+        return publications, highest_seen
+
+    async def _run_native_forward_monitor_once(
+        self, monitor: _NativeForwardMonitor
+    ) -> None:
+        client = self._client
+        if client is None:
+            raise RuntimeError("native forward monitor requires the connected userbot client")
+        source = await client.get_entity(monitor.source)
+        destination = await client.get_entity(monitor.destination_id)
+        source_id = _coerce_int(getattr(source, "id", None))
+        if source_id is None or source_id <= 0:
+            raise RuntimeError(f"native forward source resolution failed: {monitor.name}")
+        cursor = self._load_monitor_state(monitor)
+        if cursor is None:
+            self._store_monitor_state(
+                monitor, await self._latest_source_message_id(client, source), source_id
+            )
+            return
+
+        publications, highest_seen = await self._new_source_publications(
+            client, source, cursor
+        )
+        verified_cursor = cursor
+        for records in publications:
+            source_message_ids = {int(message.id) for message in records}
+            forwarded_ids = await self._destination_forward_ids(
+                client, destination, source_id
+            )
+            overlap = source_message_ids & forwarded_ids
+            if overlap == source_message_ids:
+                pass
+            elif overlap:
+                raise RuntimeError(
+                    f"native forward destination has a partial album: {monitor.name}"
+                )
+            else:
+                await client.forward_messages(destination, records, from_peer=source)
+                forwarded_ids = await self._destination_forward_ids(
+                    client, destination, source_id
+                )
+                if not source_message_ids <= forwarded_ids:
+                    raise RuntimeError(
+                        f"native forward destination verification failed: {monitor.name}"
+                    )
+            verified_cursor = max(verified_cursor, max(source_message_ids))
+            self._store_monitor_state(monitor, verified_cursor, source_id)
+        if not publications and highest_seen > cursor:
+            self._store_monitor_state(monitor, highest_seen, source_id)
+
+    def _start_native_forward_monitors(self) -> None:
+        client = self._client
+        if client is None:
+            return
+        for monitor in self.native_forward_monitors:
+            existing = self._native_forward_tasks.get(monitor.name)
+            if existing is not None and not existing.done():
+                continue
+            task = asyncio.create_task(
+                self._native_forward_monitor_loop(monitor, client),
+                name=f"telegram-userbot-native-forward-{monitor.name}",
+            )
+            self._native_forward_tasks[monitor.name] = task
+
+    async def _native_forward_monitor_loop(
+        self, monitor: _NativeForwardMonitor, client: Any
+    ) -> None:
+        current_task = asyncio.current_task()
+        try:
+            while self._running and self._client is client:
+                try:
+                    await self._run_native_forward_monitor_once(monitor)
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    logger.error(
+                        "[TELEGRAM_USERBOT] native forward monitor %s failed: %s",
+                        monitor.name,
+                        exc,
+                    )
+                await asyncio.sleep(monitor.interval_seconds)
+        finally:
+            if self._native_forward_tasks.get(monitor.name) is current_task:
+                self._native_forward_tasks.pop(monitor.name, None)
+
+    async def _cancel_native_forward_monitors(self) -> None:
+        tasks = list(self._native_forward_tasks.values())
+        self._native_forward_tasks.clear()
+        for task in tasks:
+            task.cancel()
+        if tasks:
+            await asyncio.gather(*tasks, return_exceptions=True)
+
