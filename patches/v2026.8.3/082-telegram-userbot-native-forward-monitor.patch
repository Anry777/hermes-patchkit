+class FakeNativeForwardClient:
+    """Small in-memory Telethon surface for native-forward monitor tests."""
+
+    def __init__(
+        self,
+        source_messages,
+        destination_messages=(),
+        *,
+        dropped_forward_ids=(),
+        preserves_source_header=True,
+        author_username: str | None = "kirill",
+    ):
+        self.source_messages = list(source_messages)
+        self.destination_messages = list(destination_messages)
+        self.dropped_forward_ids = set(dropped_forward_ids)
+        self.preserves_source_header = preserves_source_header
+        self.author_username = author_username
+        self.forward_calls = []
+        self.sent_messages = []
+
+    async def get_entity(self, entity_id):
+        entity_id = abs(int(entity_id))
+        if entity_id == 7001:
+            return SimpleNamespace(
+                id=7001,
+                access_hash=987654321,
+                first_name="Кирилл",
+                last_name=None,
+                username=self.author_username,
+            )
+        return SimpleNamespace(id=entity_id)
+
+    async def iter_messages(self, entity, **_kwargs):
+        messages = (
+            self.source_messages
+            if int(getattr(entity, "id", entity)) == 1001
+            else self.destination_messages
+        )
+        for message in sorted(messages, key=lambda item: item.id, reverse=True):
+            yield message
+
+    async def forward_messages(self, destination, messages, *, from_peer):
+        records = list(messages)
+        self.forward_calls.append(
+            {"destination": destination, "messages": records, "from_peer": from_peer}
+        )
+        delivered = []
+        for message in records:
+            if message.id in self.dropped_forward_ids:
+                delivered.append(None)
+                continue
+            forwarded = SimpleNamespace(
+                id=10000 + message.id,
+                message=message.message,
+                fwd_from=(
+                    SimpleNamespace(
+                        channel_post=message.id,
+                        from_id=SimpleNamespace(channel_id=1001),
+                    )
+                    if self.preserves_source_header
+                    else SimpleNamespace(from_name="source sender")
+                ),
+            )
+            self.destination_messages.append(forwarded)
+            delivered.append(forwarded)
+        return delivered
+
+    async def send_message(self, destination, message, **kwargs):
+        self.sent_messages.append(
+            {"destination": destination, "message": message, **kwargs}
+        )
+        return SimpleNamespace(id=20000 + len(self.sent_messages))
+
+
+def native_forward_message(message_id, *, grouped_id=None, text="", sender_id=None):
+    return SimpleNamespace(
+        id=message_id,
+        grouped_id=grouped_id,
+        action=None,
+        message=text,
+        sender_id=sender_id,
+    )
+
 
