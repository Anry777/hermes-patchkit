+@pytest.mark.asyncio
+async def test_native_forward_monitor_seeds_then_forwards_a_complete_album(
+    tmp_path, monkeypatch
+):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    from plugins.platforms.telegram_userbot.adapter import TelegramUserbotAdapter
+
+    adapter = TelegramUserbotAdapter(
+        PlatformConfig(
+            enabled=True,
+            extra={
+                "native_forward_monitors": [{
+                    "name": "source-to-destination",
+                    "source_id": 1001,
+                    "destination_id": 2002,
+                    "interval_seconds": 10800,
+                }]
+            },
+        )
+    )
+    client = FakeNativeForwardClient([
+        native_forward_message(102, grouped_id=77),
+        native_forward_message(101, grouped_id=77),
+    ])
+    adapter._client = client
+    monitor = adapter.native_forward_monitors[0]
+
+    await adapter._run_native_forward_monitor_once(monitor)
+
+    state_path = tmp_path / "native_forwards" / "source-to-destination.json"
+    assert client.forward_calls == []
+    assert json.loads(state_path.read_text()) == {
+        "destination_id": 2002,
+        "last_processed_message_id": 102,
+        "source_id": 1001,
+    }
+
+    client.source_messages.extend([
+        native_forward_message(104, grouped_id=88),
+        native_forward_message(103, grouped_id=88),
+    ])
+    await adapter._run_native_forward_monitor_once(monitor)
+
+    assert [[item.id for item in call["messages"]] for call in client.forward_calls] == [
+        [103, 104]
